ARG GO_BUILD_IMAGE=golang:1.26-alpine
ARG ALPINE_IMAGE=alpine:3.22

FROM ${GO_BUILD_IMAGE} AS build

WORKDIR /src
COPY server/ ./
# Vendored modules keep self-hosted and CI builds reproducible even when the
# public Go module proxy is unavailable.
RUN CGO_ENABLED=0 go build -mod=vendor -trimpath -ldflags="-s -w" -o /out/repomender ./cmd/repomender

FROM ${ALPINE_IMAGE}

COPY --from=build /out/repomender /usr/local/bin/repomender
USER 65532:65532
ENTRYPOINT ["repomender"]
