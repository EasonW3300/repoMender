# Local Docker Compose settings. Replace the development password before
# exposing RepoMender outside the local host.
REPOMENDER_HTTP_PORT=8088
REPOMENDER_POSTGRES_PASSWORD=change-me

# Direct API/worker development settings.
REPOMENDER_DATABASE_URL=postgres://repomender:change-me@127.0.0.1:5432/repomender?sslmode=disable
REPOMENDER_HTTP_ADDRESS=:8080
REPOMENDER_PUBLIC_URL=http://localhost:8088
REPOMENDER_SHUTDOWN_TIMEOUT=10
REPOMENDER_WORKER_POLL_INTERVAL=2
REPOMENDER_SESSION_TTL=28800
REPOMENDER_COOKIE_SECURE=false

# Optional OIDC. All three values must be supplied together.
REPOMENDER_OIDC_ISSUER=
REPOMENDER_OIDC_CLIENT_ID=
REPOMENDER_OIDC_CLIENT_SECRET=

# M2 SCM module. The current release scope is GitHub-only.
REPOMENDER_FEATURE_M2_SCM=false
# Generate 32 random bytes and encode them with standard base64.
REPOMENDER_MASTER_KEY=

# GitHub.com App connection.
REPOMENDER_GITHUB_APP_ID=
REPOMENDER_GITHUB_APP_SLUG=
# Supply either the base64 value or a mounted PEM file path.
REPOMENDER_GITHUB_APP_PRIVATE_KEY_B64=
REPOMENDER_GITHUB_APP_PRIVATE_KEY_FILE=
REPOMENDER_GITHUB_WEBHOOK_SECRET=

# Deferred GitLab.com support. Keep false for the GitHub-only release.
# Existing adapter, schema, and contract tests remain available for later work.
REPOMENDER_FEATURE_GITLAB=false
# Required together only when REPOMENDER_FEATURE_GITLAB=true.
REPOMENDER_GITLAB_CLIENT_ID=
REPOMENDER_GITLAB_CLIENT_SECRET=
REPOMENDER_GITLAB_WEBHOOK_SECRET=

# M3 Agent Compose execution. Keep disabled until the M3 acceptance gate passes.
REPOMENDER_FEATURE_M3_AC_EXECUTION=false
# From Docker Compose on macOS, use http://host.docker.internal:7410.
REPOMENDER_AC_BASE_URL=
REPOMENDER_AC_PROJECT_ID=
REPOMENDER_AC_AGENT_NAME=codex
# Required when the AC daemon enables bearer authentication.
REPOMENDER_AC_AUTH_TOKEN=
# Optional exact build-version pin. Leave empty for AC development builds such as "0".
REPOMENDER_AC_REQUIRED_VERSION=
REPOMENDER_AC_REQUIRED_DRIVER=docker
REPOMENDER_AC_REQUEST_TIMEOUT=10
# Comma-separated literal values that must be removed from AC output.
REPOMENDER_AC_SENSITIVE_PATTERNS=

# M4 persistent tasks/runs/queue/audit. Keep disabled until the M4 gate passes.
REPOMENDER_FEATURE_M4_TASKS=false
# M5 remains disabled until the code-review gate is accepted.
REPOMENDER_FEATURE_M5_CODE_REVIEW=false
# M6 remains disabled until the CI-diagnosis gate is accepted.
REPOMENDER_FEATURE_M6_CI_DIAGNOSIS=false
REPOMENDER_FEATURE_M7_APPROVALS=false
REPOMENDER_FEATURE_M8_ISSUE_REPAIR=false
# M9 remains disabled until the automation-management gate is accepted.
REPOMENDER_FEATURE_M9_AUTOMATIONS=false

# Optional registry overrides for networks that cannot reach Docker Hub.
# REPOMENDER_GO_BUILD_IMAGE=golang:1.26-bookworm
# REPOMENDER_ALPINE_IMAGE=public.ecr.aws/docker/library/alpine:3.22
# REPOMENDER_NODE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
# REPOMENDER_GO_PROXY=https://goproxy.cn,direct
