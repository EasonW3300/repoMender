# Local Docker Compose settings. Replace the development password before
# exposing RepoMender outside the local host.
REPOMENDER_HTTP_PORT=8088
REPOMENDER_POSTGRES_PASSWORD=change-me

# Direct API/worker development settings.
REPOMENDER_DATABASE_URL=postgres://repomender:change-me@127.0.0.1:5432/repomender?sslmode=disable
REPOMENDER_HTTP_ADDRESS=:8080
REPOMENDER_PUBLIC_URL=http://localhost:8088
REPOMENDER_SHUTDOWN_TIMEOUT=10
REPOMENDER_WORKER_POLL_INTERVAL=2
REPOMENDER_SESSION_TTL=28800
REPOMENDER_COOKIE_SECURE=false

# Optional OIDC. All three values must be supplied together.
REPOMENDER_OIDC_ISSUER=
REPOMENDER_OIDC_CLIENT_ID=
REPOMENDER_OIDC_CLIENT_SECRET=

# Optional registry overrides for networks that cannot reach Docker Hub.
# REPOMENDER_GO_BUILD_IMAGE=golang:1.26-bookworm
# REPOMENDER_ALPINE_IMAGE=public.ecr.aws/docker/library/alpine:3.22
# REPOMENDER_NODE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
# REPOMENDER_GO_PROXY=https://goproxy.cn,direct
